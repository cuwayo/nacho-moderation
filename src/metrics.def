/* metrics.def - single source of truth for runtime counters.
 *
 * SPEC-ADDENDUM-SSOT S4, SPEC-ADDENDUM-TOOLCHAIN A8. Drives counter names, help
 * strings, the SIGUSR1 dump and (later) the /metrics endpoint. One M(...) row per
 * counter; never compiled on its own.
 *
 *   M(id, name, brief)
 *
 *   id      UPPER_SNAKE, unique, becomes METRIC_<id>
 *   name    Prometheus-style metric name [a-z_][a-z0-9_]*
 *   brief   1-256 chars, English, the metric HELP string
 */
M(UPDATES_RECEIVED, "updates_received_total", "Updates received from Telegram")
M(API_CALLS, "api_calls_total", "Bot API calls issued, by method and status")
M(API_429, "api_429_total", "HTTP 429 responses received")
M(RETRIES, "retries_total", "Request retries after backoff")
M(QUEUE_DEPTH, "queue_depth", "Requests currently queued by the rate limiter")
M(DB_JOB_MS, "db_job_milliseconds", "Time spent processing DB jobs")
M(LOOP_MAX_ITER_MS, "loop_max_iteration_milliseconds", "Longest event-loop iteration")
M(ACTIVE_CONNS, "active_connections", "Open Bot API connections")
