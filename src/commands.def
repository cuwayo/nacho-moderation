/* commands.def - single source of truth for bot commands.
 *
 * SPEC-ADDENDUM-SSOT S2. This file is #include-ed (never compiled on its own), so
 * it has no include guard and no declarations: only X(...) rows.
 *
 *   X(id, name, min_role, user_right, bot_right, flags, usage, brief, handler)
 *
 *   id          UPPER_SNAKE, unique, becomes CMD_<id>
 *   name        lowercase [a-z0-9_]{1,32}, unique, Telegram command name (without '/')
 *   min_role    ROLE_ANYONE | ROLE_ADMIN | ROLE_OWNER | ROLE_SUDO
 *   user_right  RIGHT_NONE | RIGHT_RESTRICT | RIGHT_DELETE | RIGHT_PIN |
 *               RIGHT_PROMOTE | RIGHT_CHANGE_INFO (right the CALLER must hold;
 *               owner and sudo bypass)
 *   bot_right   same set; right the BOT must hold in the chat
 *   flags       CMDF_* OR-ed: CMDF_TARGET, CMDF_REPLY_REQUIRED, CMDF_DURATION,
 *               CMDF_REASON, CMDF_GROUP_ONLY, CMDF_HIDDEN
 *   usage       argument synopsis, e.g. "[target] [duration] [reason]"
 *   brief       1-256 chars, English, shown in /help and setMyCommands
 *   handler     function name: int handler(cmd_ctx_t *ctx)
 *
 * M0 seeds only /help (S10); M4 adds the moderation commands of SPEC section 5.2
 * (ban, unban, kick, mute, unmute, del, pin, unpin, purge); the remaining command
 * groups (warns, settings, locks, ...) land in M5-M6.
 */
X(HELP, "help", ROLE_ANYONE, RIGHT_NONE, RIGHT_NONE, 0, "", "Show available commands", cmd_help)
X(BAN, "ban", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_RESTRICT, CMDF_TARGET|CMDF_DURATION|CMDF_REASON|CMDF_GROUP_ONLY, "[target] [duration] [reason]", "Ban a user from the chat", cmd_ban)
X(UNBAN, "unban", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_RESTRICT, CMDF_TARGET|CMDF_GROUP_ONLY, "[target]", "Lift a ban", cmd_unban)
X(KICK, "kick", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_RESTRICT, CMDF_TARGET|CMDF_REASON|CMDF_GROUP_ONLY, "[target] [reason]", "Remove a user so they can rejoin", cmd_kick)
X(MUTE, "mute", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_RESTRICT, CMDF_TARGET|CMDF_DURATION|CMDF_REASON|CMDF_GROUP_ONLY, "[target] [duration] [reason]", "Restrict a user from sending messages", cmd_mute)
X(UNMUTE, "unmute", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_RESTRICT, CMDF_TARGET|CMDF_GROUP_ONLY, "[target]", "Restore a user's permissions", cmd_unmute)
X(DEL, "del", ROLE_ADMIN, RIGHT_DELETE, RIGHT_DELETE, CMDF_REPLY_REQUIRED|CMDF_GROUP_ONLY, "", "Delete the replied-to message and the command", cmd_del)
X(PIN, "pin", ROLE_ADMIN, RIGHT_PIN, RIGHT_PIN, CMDF_REPLY_REQUIRED|CMDF_GROUP_ONLY, "", "Pin the replied-to message", cmd_pin)
X(UNPIN, "unpin", ROLE_ADMIN, RIGHT_PIN, RIGHT_PIN, CMDF_GROUP_ONLY, "", "Unpin the last pinned message", cmd_unpin)
X(PURGE, "purge", ROLE_ADMIN, RIGHT_DELETE, RIGHT_DELETE, CMDF_REPLY_REQUIRED|CMDF_GROUP_ONLY, "", "Delete messages from the replied message to now", cmd_purge)
X(WARN, "warn", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_RESTRICT, CMDF_TARGET|CMDF_REASON|CMDF_GROUP_ONLY, "[target] [reason]", "Warn a user; auto-act at the limit", cmd_warn)
X(UNWARN, "unwarn", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_NONE, CMDF_TARGET|CMDF_GROUP_ONLY, "[target]", "Remove a user's newest warning", cmd_unwarn)
X(WARNS, "warns", ROLE_ANYONE, RIGHT_NONE, RIGHT_NONE, CMDF_TARGET|CMDF_GROUP_ONLY, "[target]", "List your warnings, or a user's (admins)", cmd_warns)
X(RESETWARNS, "resetwarns", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_NONE, CMDF_TARGET|CMDF_GROUP_ONLY, "[target]", "Clear all of a user's warnings", cmd_resetwarns)
X(SETWARNLIMIT, "setwarnlimit", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_NONE, CMDF_GROUP_ONLY, "<n>", "Set how many warnings trigger the action", cmd_setwarnlimit)
X(SETWARNACTION, "setwarnaction", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_NONE, CMDF_GROUP_ONLY, "ban|mute|kick", "Set the action taken at the warning limit", cmd_setwarnaction)
X(SETLOG, "setlog", ROLE_OWNER, RIGHT_NONE, RIGHT_NONE, CMDF_GROUP_ONLY, "<chat_id|off>", "Set or clear the moderation log channel", cmd_setlog)
X(RELOAD, "reload", ROLE_ADMIN, RIGHT_NONE, RIGHT_NONE, CMDF_GROUP_ONLY, "", "Refresh the cached administrator list", cmd_reload)
X(SETTINGS, "settings", ROLE_ADMIN, RIGHT_CHANGE_INFO, RIGHT_NONE, CMDF_GROUP_ONLY, "", "Open the inline settings panel", cmd_settings)
X(SETWELCOME, "setwelcome", ROLE_ADMIN, RIGHT_CHANGE_INFO, RIGHT_NONE, CMDF_GROUP_ONLY, "<text>", "Set the join welcome message", cmd_setwelcome)
X(WELCOME, "welcome", ROLE_ADMIN, RIGHT_CHANGE_INFO, RIGHT_NONE, CMDF_GROUP_ONLY, "on|off", "Enable or disable the join welcome", cmd_welcome)
X(SETRULES, "setrules", ROLE_ADMIN, RIGHT_CHANGE_INFO, RIGHT_NONE, CMDF_GROUP_ONLY, "<text>", "Set the chat rules", cmd_setrules)
X(RULES, "rules", ROLE_ANYONE, RIGHT_NONE, RIGHT_NONE, CMDF_GROUP_ONLY, "", "Show the chat rules", cmd_rules)
X(LOCK, "lock", ROLE_ADMIN, RIGHT_DELETE, RIGHT_DELETE, CMDF_GROUP_ONLY, "<type> [type...]", "Lock a message type (delete + log)", cmd_lock)
X(UNLOCK, "unlock", ROLE_ADMIN, RIGHT_DELETE, RIGHT_DELETE, CMDF_GROUP_ONLY, "<type> [type...]", "Unlock a message type", cmd_unlock)
X(BLACKLIST, "blacklist", ROLE_ADMIN, RIGHT_DELETE, RIGHT_DELETE, CMDF_GROUP_ONLY, "add|del|list <word|/regex/>", "Manage the chat word/regex blacklist", cmd_blacklist)
X(ANTIFLOOD, "antiflood", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_RESTRICT, CMDF_GROUP_ONLY, "<messages> <seconds>|off", "Set the flood threshold, or turn it off", cmd_antiflood)
X(CAPTCHA, "captcha", ROLE_ADMIN, RIGHT_RESTRICT, RIGHT_RESTRICT, CMDF_GROUP_ONLY, "on|off", "Enable or disable join verification", cmd_captcha)
