/* api_methods.def - single source of truth for Telegram Bot API methods used.
 *
 * SPEC-ADDENDUM-SSOT S4. Consumed by the API client (method-name strings), the
 * rate limiter (bucket class), the retry policy (idempotent flag), the mock
 * server (C9: every method here needs a mock handler) and docs. One M(...) row
 * per method; never compiled on its own.
 *
 *   M(id, method, bucket, idempotent, brief)
 *
 *   id          UPPER_SNAKE, unique, becomes METHOD_<id>
 *   method      exact Bot API method name used in the request path
 *   bucket      BUCKET_GLOBAL | BUCKET_PER_CHAT | BUCKET_BULK (rate-limit class)
 *   idempotent  1 if safe to retry on 5xx / network error, else 0
 *   brief       1-256 chars, English, shown in docs
 */
M(GET_ME, "getMe", BUCKET_GLOBAL, 1, "Fetch the bot's own user record")
M(GET_UPDATES, "getUpdates", BUCKET_GLOBAL, 1, "Long-poll for incoming updates")
M(GET_CHAT_ADMINISTRATORS, "getChatAdministrators", BUCKET_GLOBAL, 1, "List the administrators of a chat")
M(SEND_MESSAGE, "sendMessage", BUCKET_PER_CHAT, 0, "Send a text message")
M(SET_MY_COMMANDS, "setMyCommands", BUCKET_GLOBAL, 1, "Register the bot command menu")
M(BAN_CHAT_MEMBER, "banChatMember", BUCKET_BULK, 1, "Ban a user from a chat")
M(UNBAN_CHAT_MEMBER, "unbanChatMember", BUCKET_BULK, 1, "Lift a ban")
M(RESTRICT_CHAT_MEMBER, "restrictChatMember", BUCKET_BULK, 1, "Set a user's restrictions and permissions")
M(DELETE_MESSAGE, "deleteMessage", BUCKET_BULK, 1, "Delete a single message")
M(DELETE_MESSAGES, "deleteMessages", BUCKET_BULK, 1, "Delete several messages at once")
M(PIN_CHAT_MESSAGE, "pinChatMessage", BUCKET_BULK, 1, "Pin a message")
M(UNPIN_CHAT_MESSAGE, "unpinChatMessage", BUCKET_BULK, 1, "Unpin a message")
M(GET_CHAT_MEMBER_COUNT, "getChatMemberCount", BUCKET_GLOBAL, 1, "Count the members of a chat")
M(ANSWER_CALLBACK_QUERY, "answerCallbackQuery", BUCKET_GLOBAL, 1, "Acknowledge an inline-keyboard button press")
M(EDIT_MESSAGE_TEXT, "editMessageText", BUCKET_PER_CHAT, 0, "Edit the text of a sent message")
