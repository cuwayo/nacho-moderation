{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NM_SANITIZE": "none"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (-O0 -g3)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-O0 -g3 -fno-omit-frame-pointer"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "displayName": "Debug + ASan/LSan/UBSan",
      "cacheVariables": {
        "NM_SANITIZE": "address"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "displayName": "Debug + TSan",
      "cacheVariables": {
        "NM_SANITIZE": "thread"
      }
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "displayName": "Debug + gcov coverage",
      "cacheVariables": {
        "NM_SANITIZE": "coverage"
      }
    },
    {
      "name": "fuzz",
      "inherits": "debug",
      "displayName": "Clang libFuzzer targets",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "NM_BUILD_FUZZ": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (-O2 -g -DNDEBUG -flto) + hardening",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-O2 -g -flto"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": { "outputOnFailure": true }
    }
  ]
}
