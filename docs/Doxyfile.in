# Doxyfile.in - Doxygen configuration (SPEC-ADDENDUM-DOCS D4).
# Processed by CMake configure_file() into ${CMAKE_BINARY_DIR}/docs/Doxyfile.
# WARN_AS_ERROR is NO by default (local `docs`); the `docs-check` target overrides
# it to FAIL_ON_WARNINGS for CI.

PROJECT_NAME           = "tgbot"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Asynchronous Telegram group admin bot in C using io_uring"
OUTPUT_DIRECTORY       = @CMAKE_BINARY_DIR@/docs
INPUT                  = @CMAKE_SOURCE_DIR@/README.md @CMAKE_SOURCE_DIR@/CONTRIBUTING.md @CMAKE_SOURCE_DIR@/SECURITY.md @CMAKE_SOURCE_DIR@/src @CMAKE_SOURCE_DIR@/include @CMAKE_SOURCE_DIR@/docs
FILE_PATTERNS          = *.c *.h *.md *.dox
RECURSIVE              = YES
# Resolve README image references (e.g. docs/assets/cover.png) and copy them into
# the generated HTML, so the Doxygen main page is not left with broken images.
# Only docs/assets is scanned: pointing this at the source root would drag
# third_party/ into the INPUT scan and trip WARN_AS_ERROR.
IMAGE_PATH             = @CMAKE_SOURCE_DIR@/docs/assets
EXCLUDE                = @CMAKE_SOURCE_DIR@/third_party @CMAKE_SOURCE_DIR@/tests/fixtures
EXCLUDE_PATTERNS       = */tests/*
USE_MDFILE_AS_MAINPAGE = @CMAKE_SOURCE_DIR@/README.md
MARKDOWN_SUPPORT       = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
BUILTIN_STL_SUPPORT    = NO
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = @DOXYGEN_WARN_AS_ERROR@
WARN_LOGFILE           = @CMAKE_BINARY_DIR@/docs/doxygen-warnings.log
ALIASES                = "ownership=\par Ownership:^^" \
                         "thread_safety=\par Thread safety:^^" \
                         "io_state=\par io_uring state:^^" \
                         "errors=\par Errors:^^"
PREDEFINED             = DOXYGEN_SHOULD_SKIP_THIS
