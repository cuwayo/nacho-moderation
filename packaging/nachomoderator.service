[Unit]
Description=nacho-moderator Telegram admin bot
Documentation=https://github.com/cuwayo/nacho-moderation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the working directory / interpreter to your installation.
WorkingDirectory=/var/lib/nachomoderator
ExecStart=/usr/local/bin/nacho-moderator --config /etc/nachomoderator/config.toml
Restart=on-failure
RestartSec=5s

# Run as an unprivileged, dedicated user (create with:
#   sudo useradd --system --home /var/lib/nachomoderator nachomoderator)
User=nachomoderator
Group=nachomoderator

# --- Hardening -------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077

# The bot writes only its SQLite database under /var/lib/nachomoderator.
ReadWritePaths=/var/lib/nachomoderator
StateDirectory=nachomoderator
StateDirectoryMode=0700

# The token is read from a 0600 file; never log it.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
